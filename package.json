{
	"name": "wa2dc",
	"version": "2.6.0-beta.2",
	"description": "WhatsAppToDiscord is a Discord bot that uses WhatsApp Web as a bridge between Discord and WhatsApp",
	"type": "module",
	"main": "src/runner.js",
	"scripts": {
		"start": "node src/runner.js",
		"postinstall": "node scripts/patchBaileysAndroidBrowser.js",
		"docs": "npx -y docsify-cli@4.4.4 serve docs",
		"docs:check": "node --test tests/docs.test.js",
		"bundle": "esbuild src/runner.js --bundle --platform=node --format=esm --minify-whitespace --external:sharp --external:link-preview-js --target=node24 --banner:js=\"import { createRequire as __esbuildCreateRequire } from 'module'; const require = __esbuildCreateRequire(import.meta.url);\" --outfile=out.js",
		"bundle:pkg": "node scripts/buildPkgBundle.js",
		"build:bin": "node scripts/buildBinary.js",
		"build:bin:smoke": "node scripts/buildBinary.js --smoke",
		"test": "node --test \"tests/*.test.js\"",
		"lint": "biome lint . --error-on-warnings",
		"check": "biome check . --error-on-warnings",
		"check:write": "biome check --write . --error-on-warnings",
		"ci:check": "biome ci . --error-on-warnings",
		"format": "biome format --write ."
	},
	"knip": {
		"ignoreBinaries": [
			"ffmpeg"
		],
		"ignoreDependencies": [
			"canvas",
			"jsdom",
			"lottie-web"
		]
	},
	"author": "arespawn (forked from Fatih Kilic)",
	"repository": "https://github.com/arespawn/WhatsAppToDiscord",
	"license": "MIT",
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	},
	"dependencies": {
		"@whiskeysockets/baileys": "7.0.0-rc14",
		"canvas": "^3.2.3",
		"discord.js": "^14.25.1",
		"jsdom": "^30.0.1",
		"link-preview-js": "5.0.1",
		"lottie-web": "^5.13.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.2",
		"qrcode": "^1.5.3",
		"sharp": "^0.35.1",
		"tar": "^7.5.22",
		"undici": "^7.30.1",
		"undici6": "npm:undici@6.29.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"esbuild": "^0.28.1"
	},
	"pkg": {},
	"overrides": {
		"lodash": "4.18.1",
		"form-data": "4.0.5",
		"protobufjs": "7.6.5",
		"ws": "8.21.1",
		"@whiskeysockets/baileys": {
			"link-preview-js": "$link-preview-js",
			"music-metadata": "11.16.1"
		},
		"music-metadata": {
			"file-type": "21.3.3"
		},
		"link-preview-js": {
			"undici": "8.12.3"
		},
		"discord.js": {
			"undici": "6.29.1"
		},
		"@discordjs/rest": {
			"undici": "6.29.1"
		},
		"sharp": {
			"tar-fs": "3.1.1"
		},
		"prebuild-install": {
			"tar-fs": "2.1.4"
		}
	}
}
